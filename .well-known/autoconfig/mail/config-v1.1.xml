<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="zapster.cc">
    <domain>zapster.cc</domain>
    <displayName>zapster.cc</displayName>
    <displayShortName>zapster.cc</displayShortName>

    <incomingServer type="imap">
      <hostname>wp13320587.mail.server-he.de</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>

    <outgoingServer type="smtp">
      <hostname>wp13320587.mailout.server-he.de</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
</clientConfig>
